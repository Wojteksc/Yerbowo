<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>
            <Attribute>Obsolete</Attribute>
            <Attribute>GeneratedCode</Attribute>
            <Attribute>CompilerGenerated</Attribute>
          </ExcludeByAttribute>
          <Exclude>
            <ModuleName>*.Tests</ModuleName>
            <ModuleName>*.TestAdapter</ModuleName>
            <ModuleName>coverlet.*</ModuleName>
            <ModuleName>*.GeneratedCode</ModuleName>
          </Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
